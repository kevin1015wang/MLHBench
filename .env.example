# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
# Service-role secret key (Project Settings -> API -> service_role).
# Server-only, never expose to the browser. Every API route and the review
# pipeline use it (after their own access checks) -- the public key alone
# can't read anything; see supabase/schema.sql.
SUPABASE_SERVICE_ROLE_KEY=
# Legacy JWT secret (Project Settings -> JWT Keys -> Legacy JWT Secret).
# Server-only. Signs the short-lived per-user JWTs the browser's Supabase
# client sends, which RLS uses to scope each user to their own events.
SUPABASE_JWT_SECRET=

# Google OAuth login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random secret used to sign the bench_session cookie -- generate a fresh
# value per environment (e.g. `openssl rand -base64 32`), never reuse dev's.
AUTH_SECRET=
# This Google account signs in as the admin. Anyone else who signs in with
# Google gets a self-signup account that owns its own events.
ALLOWED_LOGIN_EMAIL=
# 32 random bytes, base64 (`openssl rand -base64 32`). Encrypts users'
# OpenRouter keys at rest. Changing it makes stored keys unreadable, so
# users would have to re-enter them.
API_KEY_ENCRYPTION_KEY=
# Public URL of this deployment, used to build the OAuth redirect URI.
# Falls back to https://$NEXT_PUBLIC_VERCEL_URL if unset (see
# src/lib/auth/session.ts) -- set explicitly when using a custom domain,
# since VERCEL_URL points at the *.vercel.app preview/prod alias, not it.
NEXT_PUBLIC_APP_URL=

# GitHub
GITHUB_TOKEN=

# Gemini
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenRouter (Gemini via Vercel AI SDK). Pays for AI reviews on admin-run
# events; self-signup users' events use the owner's own key.
OPENROUTER_API_KEY=

# DigitalOcean
DO_AI_API_KEY=

# Discord
DISCORD_WEBHOOK_URL=
NEXT_PUBLIC_DISCORD_WEBHOOK_URL=