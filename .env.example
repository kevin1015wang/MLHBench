# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Google OAuth login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random secret used to sign the bench_session cookie -- generate a fresh
# value per environment (e.g. `openssl rand -base64 32`), never reuse dev's.
AUTH_SECRET=
# Only this email is allowed to log in.
ALLOWED_LOGIN_EMAIL=
# Public URL of this deployment, used to build the OAuth redirect URI.
# Falls back to https://$NEXT_PUBLIC_VERCEL_URL if unset (see
# src/lib/auth/session.ts) -- set explicitly when using a custom domain,
# since VERCEL_URL points at the *.vercel.app preview/prod alias, not it.
NEXT_PUBLIC_APP_URL=

# GitHub
GITHUB_TOKEN=

# Gemini
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenRouter (Gemini via Vercel AI SDK)
OPENROUTER_API_KEY=

# DigitalOcean
DO_AI_API_KEY=

# Discord
DISCORD_WEBHOOK_URL=
NEXT_PUBLIC_DISCORD_WEBHOOK_URL=